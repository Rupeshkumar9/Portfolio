---
import { siteConfig } from '../config';
---
<nav id="navbar" class="navbar">
  <div class="nav-container">
    <a href="/" class="nav-logo" aria-label={`${siteConfig.name} home`}>RH<span class="dot">.</span></a>

    <div class="nav-links" id="nav-links">
      <a href="/#projects" class="nav-link">/ PROJECTS</a>
      <a href="/resume/" class="nav-link">/ RESUME</a>
      <a href="/blog/" class="nav-link">/ BLOG</a>
      <a href="/#skills" class="nav-link">/ SKILLS</a>
      <a href="/#about" class="nav-link">/ ABOUT</a>
    </div>

    <div class="nav-right">
      <div class="nav-socials">
        <a href={siteConfig.socials.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="social-icon"><i class="fab fa-github"></i></a>
        <a href={siteConfig.socials.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="social-icon"><i class="fab fa-linkedin-in"></i></a>
        <a href={siteConfig.socials.x} target="_blank" rel="noopener noreferrer" aria-label="X" class="social-icon"><i class="fab fa-x-twitter"></i></a>
        <a href={siteConfig.socials.medium} target="_blank" rel="noopener noreferrer" aria-label="Medium" class="social-icon"><i class="fab fa-medium"></i></a>
        <a href={`mailto:${siteConfig.email}`} aria-label="Email" class="social-icon"><i class="fas fa-envelope"></i></a>
      </div>
      <a href={`mailto:${siteConfig.email}`} class="nav-contact">CONTACT</a>
      <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <a href="/#projects" class="mobile-link">/ PROJECTS</a>
    <a href="/resume/" class="mobile-link">/ RESUME</a>
    <a href="/blog/" class="mobile-link">/ BLOG</a>
    <a href="/#skills" class="mobile-link">/ SKILLS</a>
    <a href="/#about" class="mobile-link">/ ABOUT</a>
    <div class="mobile-socials">
      <a href={siteConfig.socials.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub"><i class="fab fa-github"></i></a>
      <a href={siteConfig.socials.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
      <a href={siteConfig.socials.x} target="_blank" rel="noopener noreferrer" aria-label="X"><i class="fab fa-x-twitter"></i></a>
      <a href={`mailto:${siteConfig.email}`} aria-label="Email"><i class="fas fa-envelope"></i></a>
    </div>
    <a href={`mailto:${siteConfig.email}`} class="mobile-contact">CONTACT</a>
  </div>
</nav>
