---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
---
<section id="projects" class="section grid-bg">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">FEATURED_PROJECTS</h2>
      <span class="section-status">STATUS: LIVE</span>
    </div>

    <div class="project-hero hud-card pulse-border">
      <div class="project-hero-grid">
        <div class="project-hero-info">
          <div class="project-hero-header">
            <div class="project-icon">🔐</div>
            <div>
              <h3 class="project-hero-title">VaultGuard</h3>
              <div class="project-status"><span class="status-dot-sm"></span><span class="status-label">MULTI-PLATFORM</span></div>
            </div>
          </div>
          <h4 class="project-hero-tagline">Zero-Knowledge <span class="text-primary">Password Security</span>.</h4>
          <p class="project-hero-desc">Offline-first password manager with client-side AES-256-GCM encryption. The server never sees your data. Built for Web, Android (native Autofill), and Browser Extensions.</p>
          <div class="project-hero-actions"><a href="https://github.com/Rupeshkumar9/VaultGuard" target="_blank" rel="noopener noreferrer" class="btn-primary">View Project <i class="fas fa-arrow-right"></i></a></div>
        </div>
        <div class="project-hero-features">
          <div class="feature-card"><i class="fas fa-shield-halved text-primary"></i><h5>AES-256 Encryption</h5><p>Client-side zero-knowledge crypto.</p></div>
          <div class="feature-card"><i class="fas fa-mobile-screen text-accent"></i><h5>Android Autofill</h5><p>Native Keystore integration.</p></div>
          <div class="feature-card"><i class="fas fa-puzzle-piece text-success"></i><h5>Browser Extension</h5><p>Manifest V3, Chrome &amp; Firefox.</p></div>
          <div class="feature-card"><i class="fas fa-database text-warning"></i><h5>Offline-First</h5><p>IndexedDB local cache + sync.</p></div>
        </div>
      </div>
      <div class="project-tags"><span class="tag">REACT</span><span class="tag">NODE.JS</span><span class="tag">MONGODB</span><span class="tag">CAPACITOR</span><span class="tag">WEB CRYPTO API</span><span class="tag">MANIFEST V3</span></div>
    </div>

    <div class="subsection-header"><span class="subsection-label">// MORE_PROJECTS</span><div class="subsection-line"></div><a href="https://github.com/Rupeshkumar9" target="_blank" rel="noopener noreferrer" class="subsection-link">VIEW ALL <i class="fab fa-github"></i></a></div>
    <div class="projects-grid-3">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</section>
