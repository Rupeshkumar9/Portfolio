---
import { vaultGuard, supportingFeaturedProjects, secondaryProjects } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";
---

<section id="projects" class="section grid-bg">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">FEATURED_PROJECTS</h2>
      <span class="section-status">STATUS: LIVE</span>
    </div>

    <!-- 1. Primary Hero Project: VaultGuard -->
    <div class="project-hero hud-card pulse-border">
      <div class="project-hero-grid">
        <div class="project-hero-info">
          <div class="project-hero-header">
            <div class="project-icon">{vaultGuard.icon}</div>
            <div>
              <h3 class="project-hero-title">{vaultGuard.name}</h3>
              <div class="project-status">
                <span class="status-dot-sm"></span><span class="status-label"
                  >{vaultGuard.badge}</span>
              </div>
            </div>
          </div>
          <h4 class="project-hero-tagline">
            Zero-Knowledge <span class="text-primary">Password Manager</span>.
          </h4>
          <p class="project-hero-desc">
            {vaultGuard.description}
          </p>
          <div class="project-hero-actions">
            <a
              href={vaultGuard.href}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary"
              >View Project <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
        <div class="project-hero-features">
          {vaultGuard.features.map((feat) => (
            <div class="feature-card">
              <i class={`${feat.icon} ${feat.colorClass}`}></i>
              <h5>{feat.title}</h5>
              <p>{feat.description}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="project-tags">
        {vaultGuard.tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </div>

    <!-- 2. Supporting Featured Projects: FinTrack & FluxBoard -->
    <div class="projects-grid-2">
      {supportingFeaturedProjects.map((project) => (
        <div class="hud-card project-card">
          <div class="project-card-header">
            <div class="project-card-title-row">
              <div class="project-emoji">
                <i class={`fas ${project.icon} text-${project.accent}`}></i>
              </div>
              <div>
                <h3 class="project-card-name">{project.name}</h3>
                <div class="project-status-sm">
                  <span class={project.accent === 'primary' ? 'dot-blue' : 'dot-purple'}></span>
                  <span class="status-label">{project.badge}</span>
                </div>
              </div>
            </div>
            <a
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
              class="project-github-link"
              aria-label={`${project.name} GitHub Repository`}
            >
              <i class="fab fa-github"></i>
            </a>
          </div>
          <p class="project-card-desc">{project.description}</p>
          <div class="project-card-tags">
            {project.tags.map((tag) => (
              <span class="tag-sm">{tag}</span>
            ))}
          </div>
          <div class="project-card-footer">
            <span class="project-sm-badge">
              <i class={`fas ${project.badgeIcon}`}></i> {project.badge}
            </span>
            <a
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
              class="project-view-link"
            >
              VIEW PROJECT <i class="fas fa-arrow-right"></i>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- 3. Secondary Project Discovery: ToxiGuard & SocialFeed Hub -->
    <div class="subsection-header">
      <span class="subsection-label">// MORE_PROJECTS</span>
      <div class="subsection-line"></div>
      <a
        href="https://github.com/Rupeshkumar9"
        target="_blank"
        rel="noopener noreferrer"
        class="subsection-link"
      >
        VIEW ALL <i class="fab fa-github"></i>
      </a>
    </div>
    <div class="projects-grid-2">
      {secondaryProjects.slice(0, 2).map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </div>
</section>
