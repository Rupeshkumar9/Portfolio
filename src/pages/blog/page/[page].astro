---
import { getPublishedPosts } from '../../../utils/blog';
import BlogCard from '../../../components/BlogCard.astro';
import BlogPagination from '../../../components/BlogPagination.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const pageSize = 10;
  const allPosts = await getPublishedPosts();
  const totalPages = Math.ceil(allPosts.length / pageSize);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const currentPage = index + 2;
    return {
      params: { page: String(currentPage) },
      props: {
        posts: allPosts.slice((currentPage - 1) * pageSize, currentPage * pageSize),
        currentPage,
        totalPages,
      },
    };
  });
}

const { posts, currentPage, totalPages } = Astro.props;
---
<BaseLayout title={`Blog page ${currentPage} | Rupesh Kumar`} description="Browse developer articles from Rupesh Kumar.">
  <section class="section section-dark archive-shell">
    <div class="container">
      <div class="blog-hero"><div class="section-status">ARCHIVE_PAGE_{String(currentPage).padStart(2, '0')}</div><h1 class="section-title">BLOG_LOG</h1><p>Developer notes ordered from newest to oldest.</p></div>
      <div class="blog-grid">{posts.map((post) => <BlogCard post={post} featured={post.data.featured} />)}</div>
      <BlogPagination currentPage={currentPage} totalPages={totalPages} />
    </div>
  </section>
</BaseLayout>
